<Window x:Class="MiniCassa.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniCassa"
        Width="520"
        Height="320"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Border CornerRadius="22"
            Background="#FFFFFF"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            Padding="28">

        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="0"
                              Opacity="0.25" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Titolo applicazione -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center">

                <TextBlock Text="MiniCassa"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Caso d'uso finale del corso WPF"
                           Margin="0,6,0,0"
                           FontSize="15"
                           Foreground="#6B7280"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Area animata -->
            <Grid Grid.Row="1"
                  Margin="0,26,0,20"
                  ClipToBounds="True">

                <Border Height="88"
                        CornerRadius="18"
                        Background="#F3F4F6"
                        VerticalAlignment="Center"
                        ClipToBounds="True">

                    <Canvas ClipToBounds="True">

                        <!-- 
                        La fila contiene più icone ripetute.
                        Lo storyboard la sposta verso sinistra, creando l'effetto "sfilata".
                        -->
                        <StackPanel x:Name="IconStrip"
                                    Orientation="Horizontal"
                                    Canvas.Left="0"
                                    Canvas.Top="15"
                                    RenderTransformOrigin="0.5,0.5">

                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="IconStripTransform"
                                                    X="0" />
                            </StackPanel.RenderTransform>

                            <TextBlock Text="🍕" FontSize="42" Margin="18,0" FontFamily="Segoe UI Emoji" />
                            <TextBlock Text="🍝" FontSize="42" Margin="18,0" FontFamily="Segoe UI Emoji" />
                            <TextBlock Text="🍖" FontSize="42" Margin="18,0" FontFamily="Segoe UI Emoji" />
                            <TextBlock Text="🥗" FontSize="42" Margin="18,0" FontFamily="Segoe UI Emoji" />
                            <TextBlock Text="🥤" FontSize="42" Margin="18,0" FontFamily="Segoe UI Emoji" />
                            <TextBlock Text="☕" FontSize="42" Margin="18,0" FontFamily="Segoe UI Emoji" />

                            <TextBlock Text="🍕" FontSize="42" Margin="18,0" FontFamily="Segoe UI Emoji" />
                            <TextBlock Text="🍝" FontSize="42" Margin="18,0" FontFamily="Segoe UI Emoji" />
                            <TextBlock Text="🍖" FontSize="42" Margin="18,0" FontFamily="Segoe UI Emoji" />
                            <TextBlock Text="🥗" FontSize="42" Margin="18,0" FontFamily="Segoe UI Emoji" />
                            <TextBlock Text="🥤" FontSize="42" Margin="18,0" FontFamily="Segoe UI Emoji" />
                            <TextBlock Text="☕" FontSize="42" Margin="18,0" FontFamily="Segoe UI Emoji" />

                        </StackPanel>
                    </Canvas>
                </Border>

                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Grid.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="IconStripTransform"
                                                 Storyboard.TargetProperty="X"
                                                 From="0"
                                                 To="-420"
                                                 Duration="0:0:3.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
            </Grid>

            <!-- Seconda informazione testuale del corso -->
            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center">

                <TextBlock Text="WPF, Binding, MVVM e interfacce desktop moderne"
                           FontSize="14"
                           Foreground="#374151"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Caricamento dell'applicazione..."
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="#6B7280"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>